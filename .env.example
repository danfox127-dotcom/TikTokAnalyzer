# Copy to .env for local development:  cp .env.example .env
# .env is gitignored. api/main.py loads it via python-dotenv on startup.

# --- Durable cache (creator resolution + oEmbed) -----------------------------
# Persists resolved TikTok→creator handles forever so coverage grows across runs
# instead of resetting. Without it, the map is in-memory only (lost on restart;
# the dashboard shows "caching is in-memory only").
#   Local (Redis on host, e.g. `docker run -p 6379:6379 redis:7-alpine`):
REDIS_URL=redis://localhost:6379/0
#   docker compose sets this to redis://redis:6379 automatically.

# --- Creator resolution tuning (utils/creator_map.py) ------------------------
# Per-run budget of still-unresolved videos. Concurrency 3 avoids TikTok oEmbed
# throttling (concurrency 8 was ~100x slower). Deadline caps request wall-time.
CREATOR_RESOLVE_BUDGET=40
CREATOR_RESOLVE_CONCURRENCY=3
CREATOR_RESOLVE_DEADLINE_S=45

# --- YouTube cross-platform bridge (utils/youtube_bridge.py) — optional ------
# Resolve TikTok creators against YouTube for topic tags. Keyless works with no
# key; set YOUTUBE_API_KEY for richer topicDetails. Off unless enabled.
# ENABLE_YOUTUBE_BRIDGE=1
# YOUTUBE_API_KEY=
